    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "tailwindcss": "4.1.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "6.4.6"
  }
